# Required
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
BOT_TOKEN=replace_with_new_telegram_bot_token
OWNER_TELEGRAM_ID=replace_with_your_telegram_numeric_id
APP_ORIGIN=https://your-mini-app-domain.example

# Optional payment providers. Keep secrets only in hosting environment.
CRYPTO_PAY_API_TOKEN=
# Random secret URL path for /webhooks/cryptobot/<secret>; HMAC is verified with CRYPTO_PAY_API_TOKEN.
CRYPTO_PAY_WEBHOOK_SECRET=
ROLLYPAY_TERMINAL_ID=
ROLLYPAY_API_KEY=
ROLLYPAY_WEBHOOK_SECRET=

# Public receiving wallet for native TON and official USDT Jetton on TON mainnet.
TON_WALLET_ADDRESS=UQBVqIZqbAt0CCiboMZ38hdBGjN7RkEZKLUuDX2F5zPRwG1v
# Optional TON Center API key (recommended for higher request limits).
TONCENTER_API_KEY=
PORT=3000
NODE_ENV=production
